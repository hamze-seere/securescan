# Max scans per IP per minute on /api/scan
SCAN_RATE_LIMIT=5

# Max scans of one hostname per 10 minutes, from all clients together
SCAN_TARGET_RATE_LIMIT=10

# Email breach check. Without a key the free XposedOrNot API is used.
# HIBP_API_KEY=
# Email checks per IP per hour, per address per hour (all clients), and per day for the whole site
EMAIL_RATE_LIMIT=3
EMAIL_TARGET_RATE_LIMIT=3
# EMAIL_DAILY_LIMIT=90

# DEVELOPMENT ONLY: allow scanning localhost / private IPs (e.g. your XAMPP site).
# Never enable this on a public deployment - it disables SSRF protection.
ALLOW_PRIVATE_TARGETS=false

# Share links (optional). Locally, an in-memory store is used automatically.
# On Vercel: Storage -> Marketplace -> Upstash for Redis -> connect to the project.
# Vercel then sets these for you:
# KV_REST_API_URL=https://xxxx.upstash.io
# KV_REST_API_TOKEN=xxxx
# Optional: key that signs reports for sharing (defaults to one derived from KV_REST_API_TOKEN).
# SHARE_SECRET=
